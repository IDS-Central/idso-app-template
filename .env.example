# Google OAuth (loaded from Secret Manager in production)
IDSO_OAUTH_CLIENT_ID=
IDSO_OAUTH_CLIENT_SECRET=
IDSO_ALLOWED_DOMAIN=

# Database (loaded from Secret Manager in production)
DATABASE_URL=postgresql://user:password@localhost:5432/appdb

# Session encryption key (hex string — generate with: python3 -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=local-dev-secret-change-me

# Encryption key for sensitive fields (hex string, 32 bytes)
ENCRYPTION_KEY=local-dev-key-change-me-32-bytes-hex

# App Config
APP_NAME=
GCP_PROJECT_ID=central-workspace

# Secret Manager (production only — lib/secrets.ts reads these automatically)
# DB_URL_SECRET_NAME={app-name}-db-url
# ENCRYPTION_KEY_SECRET_NAME={app-name}-encryption-key

# App URL (auto-detected from request if not set)
IDSO_APP_URL=

# Session lifetime in hours (default: 8)
SESSION_LIFETIME_HOURS=8

# Local dev only — bypasses OAuth (never enable in production)
IDSO_OAUTH_BYPASS_AUTH=true
